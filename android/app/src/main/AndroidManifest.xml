<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:showWhenLocked="false"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: https://nuralquran.net/… opens the app (verified with
                 https://nuralquran.net/.well-known/assetlinks.json — see docs/APP.md). Only
                 app routes; the admin area, sitemaps and files stay in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="nuralquran.net" />
                <data android:path="/" />
                <data android:pathPrefix="/reader" />
                <data android:pathPrefix="/prayer-times" />
                <data android:pathPrefix="/qibla" />
                <data android:pathPrefix="/adhkar" />
                <data android:pathPrefix="/tasbih" />
                <data android:pathPrefix="/radio" />
                <data android:pathPrefix="/daily-ayah" />
                <data android:pathPrefix="/hifz" />
                <data android:pathPrefix="/khatma" />
                <data android:pathPrefix="/search" />
                <data android:pathPrefix="/dashboard" />
                <data android:pathPrefix="/favorites" />
                <data android:pathPrefix="/notes" />
                <data android:pathPrefix="/leaderboard" />
                <data android:pathPrefix="/ijaza" />
                <data android:pathPrefix="/support" />
                <data android:pathPrefix="/settings" />
                <data android:pathPrefix="/auth/callback" />
                <data android:pathPrefix="/reset-password" />
                <data android:pathPattern="/../surah/.*" />
            </intent-filter>

            <!-- Custom scheme: Google sign-in return (nuralquran://auth?token=…) and fallback links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nuralquran" />
            </intent-filter>
        </activity>

        <!-- Lock-screen / notification media controls while the recitation or radio plays -->
        <service
            android:name=".NQMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- FCM: notifications that arrive while the app is in the background use these -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_nq" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/nq_gold" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="community" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <queries>
        <!-- @capacitor/browser: Custom Tabs for Google sign-in -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- Permissions (each one is explained in docs/APP.md → "Android permissions") -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- prayer times for "use my location" (the WebView's geolocation); stays on the device -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- adhan / reminders / daily ayah (local notifications) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- exact adhan time; user-granted ("Alarms & reminders"). USE_EXACT_ALARM is deliberately
         NOT declared: Play restricts it to alarm-clock/calendar apps (see docs/APP.md). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- recitation / radio keep playing with the screen off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Voice rooms: the microphone is used only while the user speaks on a room's stage
         (asked at runtime by Capacitor's WebChromeClient on the first getUserMedia); audio is
         live and never recorded (privacy policy, docs/APP.md §9). MODIFY_AUDIO_SETTINGS lets the
         WebView switch to communication mode for echo cancellation.
         FOREGROUND_SERVICE_MICROPHONE is NOT declared: speaking stops when the app goes to the
         background (Android 14+ requires a microphone foreground service for that). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>

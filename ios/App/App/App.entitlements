<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability (rooms). Xcode switches it to "production" when archiving for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: https://nuralquran.net/… (served file: public/.well-known/apple-app-site-association) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:nuralquran.net</string>
	</array>
	<!-- Lets the adhan arrive as a time-sensitive notification when the user opts in (respects Focus settings) -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>

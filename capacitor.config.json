{
  "appId": "net.nuralquran.app",
  "appName": "نور القرآن",
  "webDir": "dist",
  "loggingBehavior": "debug",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": false,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#0B2A1E",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_nq",
      "iconColor": "#C9A84C"
    },
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover",
      "style": "DARK",
      "animation": "NONE"
    }
  },
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#0B2A1E",
    "preferredContentMode": "mobile",
    "appendUserAgent": "NurAlQuranApp"
  },
  "android": {
    "backgroundColor": "#0B2A1E",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "appendUserAgent": "NurAlQuranApp"
  }
}

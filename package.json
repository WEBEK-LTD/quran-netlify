{
  "name": "noor-alquran",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/seo-build.mjs",
    "build:seo": "node scripts/seo-build.mjs",
    "seo:data": "node scripts/seo-fetch-data.mjs",
    "preview": "vite preview",
    "build:web-app": "vite build && node scripts/app-web-assets.mjs",
    "build:app": "npm run build:web-app && cap sync",
    "build:android": "npm run build:web-app && cap sync android",
    "build:ios": "npm run build:web-app && cap sync ios",
    "android": "npm run build:android && cap open android",
    "ios": "npm run build:ios && cap open ios",
    "cap:sync": "cap sync",
    "app:assets": "node scripts/app-icons.mjs && capacitor-assets generate --assetPath store-assets/app --android --ios --iconBackgroundColor '#06100C' --iconBackgroundColorDark '#06100C' --splashBackgroundColor '#060D0A' --splashBackgroundColorDark '#060D0A'",
    "app:adhan": "bash scripts/fetch-adhan.sh",
    "test:native": "TZ=America/New_York node --test scripts/test-adhan-schedule.mjs scripts/test-push-routes.mjs",
    "check:native": "node scripts/check-native.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/amiri-quran": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "livekit-client": "2.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.1.0"
  },
  "description": "نور القرآن — تطبيق القرآن الكريم الشامل",
  "author": "Abdelrahman Hamdy",
  "license": "MIT"
}

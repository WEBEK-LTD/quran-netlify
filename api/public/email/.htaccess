# Images and web fonts used by the site's emails. Mail apps load fonts from another origin,
# so they need CORS; everything here is public and changes only with ?v= in the email.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|png)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=2592000"
    Header set Cross-Origin-Resource-Policy "cross-origin"
  </FilesMatch>
</IfModule>
